{
  "manifest_version": 1,
  "id": "youtube.subtitles",
  "version": "0.1.1",
  "requires": {
    "pack_api": 1,
    "dependencies": []
  },
  "files": [
    "reader.py",
    "LICENSE"
  ],
  "entrypoints": {
    "reader": {
      "interface": "python-jsonl-v1",
      "file": "reader.py"
    }
  },
  "features": [
    {
      "id": "subtitle-archive",
      "label": "Subtitle archive",
      "value": "Captured details and subtitles",
      "folder": "data/readers/youtube.subtitles"
    }
  ],
  "config": {},
  "access": {
    "origins": [
      "https://www.youtube.com",
      "https://youtube.com"
    ],
    "capabilities": [
      "capture.read"
    ]
  }
}
